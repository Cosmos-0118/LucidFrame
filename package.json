{
  "name": "lucidframe",
  "version": "2.0.0",
  "description": "Offline AI image and video upscaler. One install, no setup.",
  "private": true,
  "license": "MIT",
  "author": "Cosmos-0118",
  "homepage": "https://github.com/Cosmos-0118/LucidFrame",
  "type": "module",
  "main": "src/main/main.js",
  "bin": {
    "lucidframe": "bin/lucidframe.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config src/renderer/vite.config.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/e2e/*.e2e.mjs",
    "doctor": "node bin/lucidframe.js doctor",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "pack": "npm run build && electron-builder --dir",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "cli": "node bin/lucidframe.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "desktopName": "lucidframe.desktop",
  "productName": "LucidFrame"
}
